{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://Ligamina.local/contracts/lab/compat/v2/compatibility-matrix.schema.json",
  "title": "Compatibility matrix v2: Phase 7 discovery, differential, contract and stateful dimensions",
  "type": "object",
  "required": ["schema_version", "kind", "base_matrix", "dimensions", "values", "sources", "summary", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "compatibility_matrix" },
    "base_matrix": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "const": "outputs/compat/compatibility-matrix-v1.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "dimensions": {
      "type": "array",
      "items": { "enum": ["discovery", "differential", "contract", "stateful"] }
    },
    "values": {
      "type": "array",
      "items": { "enum": ["verified", "failed", "skipped", "unknown", "untested"] }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "summary": { "type": "object" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "ref"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "required": ["value", "reason", "evidence", "scope"],
      "properties": {
        "value": { "enum": ["verified", "failed", "skipped", "unknown"] },
        "reason": { "type": ["string", "null"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "scope": { "type": "string", "minLength": 1 },
        "coverage": { "type": "object" }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "propertyNames": { "enum": ["linux"] },
      "additionalProperties": { "$ref": "#/$defs/claim" }
    },
    "entry": {
      "type": "object",
      "required": ["registry_entry_id", "ecosystem", "package", "version", "artifact_sha256", "catalog_status", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "registry_entry_id": { "type": "string", "pattern": "^(ko|nb|ab)-[0-9a-f]{24}$" },
        "ecosystem": { "enum": ["koishi", "nonebot", "astrbot"] },
        "package": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "artifact_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "catalog_status": { "type": ["string", "null"] },
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["discovery", "differential", "contract", "stateful"] },
          "additionalProperties": { "$ref": "#/$defs/platforms" }
        }
      }
    }
  }
}
